# ÉLAN server environment. Copy to `.env` and adjust. Never commit the real file.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (or a local mongod).
MONGODB_URI=mongodb://127.0.0.1:27017/elan

# Browser origins allowed to call the API and open sockets (comma separated, no trailing slash).
CLIENT_ORIGINS=http://localhost:3000
# Public URL of the website. Used in emails and payment redirects.
PUBLIC_CLIENT_URL=http://localhost:3000

# Number of reverse proxies in front of the API.
# 1 when the browser talks to Render directly, 2 when the Next.js app proxies /api (Vercel rewrite + Render).
TRUST_PROXY=1

# Sessions (opaque token stored hashed in MongoDB, sent as an httpOnly cookie).
SESSION_COOKIE_NAME=elan_session
SESSION_TTL_DAYS=30
COOKIE_SECURE=auto
COOKIE_SAMESITE=lax

# Secrets. Use long random strings (32+ chars) in production. The dev defaults are rejected when NODE_ENV=production.
SOCKET_TOKEN_SECRET=dev-socket-secret-change-me-please-0001
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret-change-me-please-001

# Restaurant timezone offset in minutes from UTC (Asia/Dhaka = 360, no daylight saving).
RESTAURANT_TZ_OFFSET_MINUTES=360

# Email (optional). Without SMTP_HOST, emails are written to the server log and stored as in-app notifications only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ÉLAN <no-reply@elan.example>"

# Image uploads (optional). Without these, uploads are stored in ./uploads (development only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Demo data. The demo seed creates accounts with published passwords, so it refuses to run
# in production unless this is true. Use `npm run seed:content` + `npm run seed:admin` for a real launch.
ALLOW_DEMO_SEED=false
# Used by `npm run seed:admin` to create the first owner account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Owner

# Labelled demo deployment: shows password-reset links on screen when SMTP is not configured. Leave false for a real restaurant.
DEMO_MODE=false
