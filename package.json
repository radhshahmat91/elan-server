{
  "name": "elan-server",
  "version": "1.0.0",
  "private": true,
  "description": "ÉLAN restaurant platform: REST API and realtime service (Express, Socket.IO, MongoDB).",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "seed": "node seed.js --demo",
    "seed:demo": "node seed.js --demo",
    "seed:reset": "node seed.js --demo --reset",
    "seed:content": "node seed.js --content",
    "seed:admin": "node seed.js --admin",
    "test": "node --test tests/*.test.js",
    "docs:api": "node scripts/generate-api-docs.mjs ../docs/api-documentation.md"
  },
  "dependencies": {
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5",
    "multer": "^2.0.0",
    "nodemailer": "^6.10.0",
    "pdfkit": "^0.16.0",
    "socket.io": "^4.8.1",
    "zod": "^3.25.0"
  }
}
